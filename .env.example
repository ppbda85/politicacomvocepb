# Copie este arquivo para .env.local (desenvolvimento) e configure as
# mesmas variáveis no painel da Vercel (Project → Settings → Environment
# Variables) para produção. Veja o README para o passo a passo completo.

# Conexão com o banco Postgres (Neon). A Vercel preenche isso sozinha
# quando você conecta um banco na aba Storage do projeto.
DATABASE_URL=

# Token de acesso ao Vercel Blob (upload de fotos). A Vercel preenche isso
# sozinha quando você cria um Blob Store na aba Storage do projeto.
BLOB_READ_WRITE_TOKEN=

# Senha para entrar no painel /admin. Escolha uma senha forte.
ADMIN_PASSWORD=

# Uma string aleatória qualquer, usada para assinar a sessão de login.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
